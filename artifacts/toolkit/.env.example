# Copy this to .env.local and set your local values
PORT=3000
BASE_PATH=/

# Optional browser features. Leave off for the standalone local preview.
VITE_ENABLE_AI=false
VITE_ENABLE_USAGE_TRACKING=false
# Set a real private contact address before publishing.
VITE_CONTACT_EMAIL=
# Set to your final HTTPS origin before building for publication.
VITE_SITE_URL=
# Optional Firebase web-app settings (public configuration, not admin secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public operator identity. Required by the publication readiness check.
VITE_OPERATOR_NAME=
VITE_OPERATOR_JURISDICTION=
VITE_OPERATOR_ADDRESS=
# Optional brand default: original, monogram, brackets, tiles, orbit, diamond
VITE_DEFAULT_LOGO=original
# Optional real publisher ID for review metadata only; this does not enable ads.
VITE_ADSENSE_PUBLISHER_ID=

# Phone login is separately enabled after SMS regions, billing and consent review.
VITE_ENABLE_PHONE_AUTH=false
