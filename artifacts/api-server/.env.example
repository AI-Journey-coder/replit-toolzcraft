# Runtime secrets: set through your host's secret manager, never VITE_ variables.
NODE_ENV=production
PORT=5000
APP_ORIGIN=
DATABASE_URL=
FIREBASE_PROJECT_ID=
# Preferred: workload identity / Application Default Credentials.
# Alternative: path to a securely mounted JSON file, outside the web root.
GOOGLE_APPLICATION_CREDENTIALS=
# Or supply FIREBASE_SERVICE_ACCOUNT_JSON through the secret manager.
ADMIN_FIREBASE_UIDS=
ENABLE_AI=false
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
ENABLE_USAGE_TRACKING=false
# Exact reverse-proxy CIDRs, if the API is behind a trusted proxy.
TRUST_PROXY=

# Razorpay: server-only configuration. Disabled until checkout/access rules are set.
ENABLE_PAYMENTS=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false

# Exact INR 199.00 plan with period=monthly, interval=1.
RAZORPAY_MONTHLY_PLAN_ID=
